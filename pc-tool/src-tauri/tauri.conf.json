{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小雨run取码",
  "version": "3.0.0",
  "identifier": "com.xiaoyu.run.extract",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "小雨run · 取码",
        "width": 470,
        "height": 585,
        "minWidth": 430,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#0b0c0e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "小雨run 取码工具",
    "longDescription": "读取本机微信缓存，提取 OpenID 并给出二维码。"
  }
}